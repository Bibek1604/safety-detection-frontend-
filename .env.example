# Backend API URL. The client appends /api if it is missing.
# Leave blank locally to use the Vite /api proxy below.
# On Render, set this to your backend URL (e.g. https://your-backend.onrender.com/api) and rebuild.
VITE_API_URL=
# Local dev only: where the Vite proxy forwards /api. Must match backend PORT.
VITE_PROXY_TARGET=http://localhost:5000
